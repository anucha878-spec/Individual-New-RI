ห้ครบถ้วน\\\" บนหน้าจอค้นหา``1.13``ปุ่ม \\\"ล้างเงื่อนไข\\\" ![img](/download/thumbnails/1148387712/image2024-4-19%2017%3A15%3A22.png?version=1&modificationDate=1713521722317&api=v2)``Button``On Initial``ระบบจะแสดง Criteria เป็น Default หลังกดปุ่ม``อ้างอิงเหตุการณ์ หน้าจอแรก - แสดง Default เงื่อนไขการค้นหา` `Enable``ตลอดเวลา``1.14``ปุ่ม \\\"ค้นหา\\\"` `![img](/download/thumbnails/1148387712/image2024-4-19%2017%3A14%3A3.png?version=1&modificationDate=1713521642418&api=v2)``Button``On Click``ค้นหารายการข้อมูลที่สอดคล้องกับ Criteria ที่เลือกไว้บนหน้าจอแสดงรายการ` ตัวอย่าง ปรับแก้ไข 16.12.2567 ปรับการแสดงผลกรณี จำนวนเงิน EDW เป็น null (กรณี SUCCESS, CANCEL)) <![CDATA[WITH tx_adwpc_process_log_group AS ( SELECT id, status, system_key, edw_reconcile_amount, tx_adwpc_dashboard_manual_id, tx_adwpc_dashboard_daily_id, tx_adwpc_dashboard_payment_id, tx_adwpc_dashboard_monthly_id FROM tx_adwpc_process_log WHERE id IN ( SELECT MAX(id) as id FROM tx_adwpc_process_log GROUP BY system_key ) ) SELECT trs.id, trs.status as reconcileStatus, (CASE WHEN ((trs.status = &#39;S&#39; AND coalesce (trs.source_amount,0) = coalesce (tapl.edw_reconcile_amount,0) AND trs.source_amount NOTNULL AND tapl.edw_reconcile_amount NOTNULL AND tapl.status IN (&#39;SUCCESS&#39;)) OR (tapl.status IN (&#39;CANCEL&#39;) AND COALESCE(tadm.dashboard_status, tadd.status, tadp.dashboard_status, tadm2.dashboard_status) = &#39;CANCEL&#39; AND trs.event_code NOT IN (&#39;UL_D_01&#39;,&#39;UL_D_02&#39;))) THEN &#39;SUCCESS&#39; ELSE &#39;FAIL&#39; END) AS reconcileStatStatus, tapl.status AS processLogStatusEdw, COALESCE(cac_processLog.config_detail, tapl.status) AS processLogStatus, trs.process_type, trs.system, cd.department_display_name, trs.process_date, ceg.event_group, ceg.event_group_name, cmo.manual_oper_display_name, cec.event_code_name, cec.event_code, tmo.txn_count, tmo.net_amount, trs.source_amount, tapl.edw_reconcile_amount, trs.operation_imported_by, trs.requested_payment_date, trs.accounting_date, trs.operation_checked_by, trs.operation_checked_date, trs.operation_approved_by, trs.operation_approved_date, COALESCE(cac_sun.config_detail, COALESCE(tadm.sap_status, tadd.status, tadp.sap_status, tadm2.sap_status)) as statusGenSun, cef.event_type, cec.payment_user_type, COALESCE(tadm.reference_number, tadd.reference_number, tadp.reference_number, tadm2.reference_number) as referenceNumber FROM tx_reconcile_stats trs LEFT JOIN tx_adwpc_process_log_group tapl ON trs.system_key = tapl.system_key LEFT JOIN tx_manual_oper_mappingetl tmom on tapl.id = tmom.tx_adwpc_process_log_id LEFT JOIN tx_manual_oper tmo ON tmom.tx_manual_oper_id = tmo.id LEFT JOIN cf_manual_oper cmo ON tmo.manual_oper_code = cmo.manual_oper_code LEFT JOIN tx_adwpc_dashboard_manual tadm ON tapl.tx_adwpc_dashboard_manual_id = tadm.id LEFT JOIN tx_adwpc_dashboard_daily tadd ON tapl.tx_adwpc_dashboard_daily_id = tadd.id LEFT JOIN tx_adwpc_dashboard_payment tadp ON tapl.tx_adwpc_dashboard_payment_id = tadp.id LEFT JOIN tx_adwpc_dashboard_monthly tadm2 ON tapl.tx_adwpc_dashboard_monthly_id = tadm2.id INNER JOIN cf_event_code cec ON trs.event_code = cec.event_code INNER JOIN cf_event_flow cef ON cec.sub_system_group = cef.sub_system_group INNER JOIN cf_department cd ON cef.department_code = cd.department_code INNER JOIN cf_event_group ceg ON cef.event_group = ceg.event_group LEFT JOIN cf_adwpc_catalog cac_processLog ON cac_processLog.type = &#39;STATUS&#39; AND cac_processLog.config1 = &#39;PROCESS_LOG&#39; AND cac_processLog.active_flag = true AND cac_processLog.config2 = tapl.status LEFT JOIN cf_adwpc_catalog cac_sun ON cac_sun.type = &#39;STATUS&#39; AND cac_sun.config1 = &#39;SUN&#39; AND cac_sun.active_flag = true AND cac_sun.config2 = COALESCE(tadm.sap_status, tadd.status, tadp.sap_status, tadm2.sap_status) -------------------------------------------------------------------------------- -- กรณี 1 เลือกสถานะรายการเป็น &quot;ทั้งหมด&quot; WHERE trs.status &lt;&gt; &#39;C&#39; AND NOT EXISTS (SELECT trs1.id FROM tx_reconcile_stats trs1 WHERE trs.id = trs1.id AND trs1.status = &#39;R&#39; AND date(trs1.process_date) &gt; current_date) -- กรณี 2 เลือกสถานะรายการเป็น &quot;SUCCESS&quot; WHERE ( (trs.status = &#39;S&#39; AND coalesce (trs.source_amount,0) = coalesce (tapl.edw_reconcile_amount,0) AND trs.source_amount notnull AND tapl.edw_reconcile_amount notnull AND tapl.status in (&#39;SUCCESS&#39;)) OR (tapl.status in (&#39;CANCEL&#39;) AND COALESCE(tadm.dashboard_status, tadd.status, tadp.dashboard_status, tadm2.dashboard_status) = &#39;CANCEL&#39; AND trs.event_code NOT IN (&#39;UL_D_01&#39;,&#39;UL_D_02&#39;)) ) -- กรณี 3 เลือกสถานะรายการเป็น &quot;FAIL&quot; WHERE trs.status &lt;&gt; &#39;C&#39; AND ( trs.status = &#39;R&#39; OR tapl.status is null OR (tapl.status not in (&#39;SUCCESS&#39;,&#39;CANCEL&#39;) AND trs.event_code NOT IN (&#39;UL_D_01&#39;,&#39;UL_D_02&#39;)) OR (tapl.status = &#39;SUCCESS&#39; AND (trs.source_amount is null or tapl.edw_reconcile_amount IS NULL)) OR (tapl.status = &#39;SUCCESS&#39; AND trs.source_amount &lt;&gt; tapl.edw_reconcile_amount) OR (tapl.status = &#39;CANCEL&#39; AND COALESCE(tadm.dashboard_status, tadd.status, tadp.dashboard_status, tadm2.dashboard_status) &lt;&gt; &#39;CANCEL&#39; AND trs.event_code NOT IN (&#39;UL_D_01&#39;,&#39;UL_D_02&#39;)) OR (tapl.status &lt;&gt; &#39;SUCCESS&#39; AND trs.event_code in (&#39;UL_D_01&#39;,&#39;UL_D_02&#39;)) ) AND NOT EXISTS (SELECT trs1.id FROM tx_reconcile_stats trs1 WHERE trs.id = trs1.id AND trs1.status = &#39;R&#39; AND date(trs1.process_date) &gt; current_date) -------------------------------------------------------------------------------- AND cd.department_code IN (&lt;departmentCodeList&gt;) AND trs.system IN (&lt;systemList&gt;) AND cmo.manual_oper_code IN (&lt;manualOperCodeList&gt;) AND trs.event_code IN (&lt;eventCodeList&gt;) AND date(trs.operation_approved_date) BETWEEN :oad_from_date AND :oad_to_date AND date(trs.accounting_date) BETWEEN :ad_from_date AND :ad_to_date AND date(trs.requested_payment_date) BETWEEN :rpd_from_date AND :rpd_to_date order by date(trs.operation_approved_date), trs.accounting_date, cf_department.department_code, cmo.manual_oper_display_name, cec.event_code_name, reconcile_status ;]]> ตัวอย่าง sql (รวมกรณี Daily เก่า) ปรับแก้ไข 22.09.2567 ปรับการแสดงผล Column สถานะประมวลผลส่ง EDW, สถานะ Gen SUN <![CDATA[select (case when trs.status = &#39;S&#39; and trs.source_amount = tapl.edw_reconcile_amount and tapl.status in (&#39;SUCCESS&#39;) then &#39;SUCCESS&#39; when trs.status = &#39;S&#39; and trs.source_amount = tapl.edw_reconcile_amount and trs.event_code not in (&#39;UL_D_00&#39;,&#39;UL_D_01&#39;,&#39;UL_D_02&#39;) and tapl.status in (&#39;CANCEL&#39;) then &#39;SUCCESS&#39; when trs.status = &#39;S&#39; and trs.source_amount = tapl.edw_reconcile_amount and trs.event_code in (&#39;UL_D_00&#39;,&#39;UL_D_01&#39;,&#39;UL_D_02&#39;) and tapl.status in (&#39;CANCEL&#39;) then &#39;FAIL&#39; else &#39;FAIL&#39; end) as reconcile_status ,(case when trs.process_type = &#39;A&#39; then &#39;Auto&#39; when trs.process_type = &#39;M&#39; then &#39;Manual&#39; end) as process_type ,trs.system as &quot;ระบบงาน&quot; ,cd.department_display_name as &quot;ส่วนงาน&quot; ,date(trs.process_date) as &quot;วันที่นำเข้าข้อมูล&quot; ,ceg.event_group_name as &quot;กลุ่มธุรกรรม&quot; ,cmo.manual_oper_display_name as &quot;รายการธุรกรรมPS&quot; ,cec.event_code_name as &quot;รายการธุรกรรมAC&quot; ,tmo.txn_count as &quot;จำนวนรายการอนุมัติ&quot; ,coalesce(tmo.net_amount, trs.source_amount) as &quot;จำนวนเงินระบบต้นทาง&quot; ,tapl.edw_reconcile_amount as &quot;จำนวนเงินedw&quot; ,trs.operation_imported_by as &quot;ผู้ทำรายการ&quot; ,trs.requested_payment_date as &quot;วันที่รับจ่าย&quot; ,trs.accounting_date as &quot;วันที่บันทึกบัญชี&quot; ,trs.operation_checked_by as &quot;ผู้ตรวจสอบ&quot; ,date(trs.operation_checked_date) as &quot;วันที่ตรวจสอบ&quot; ,trs.operation_approved_by as &quot;ผู้อนุมัติ&quot; ,date(trs.operation_approved_date) as &quot;วันที่อนุมัติ&quot; ,(case when trs.status = &#39;S&#39; then &#39;APPROVED&#39; end) as &quot;สถานะ&quot; ,coalesce((select config_detail from cf_adwpc_catalog cac1 where cac1.type = &#39;STATUS&#39; and cac1.config1 = &#39;PROCESS_LOG&#39; and tapl.status = cac1.config2),tapl.status) as &quot;สถานะประมวลผลส่งEDW&quot; ,coalesce((select config_detail from cf_adwpc_catalog cac1 where cac1.type = &#39;STATUS&#39; and cac1.config1 = &#39;SUN&#39; and coalesce(tadm.sap_status, tadd.status, tadp.sap_status, tadm2.sap_status) = cac1.config2),coalesce(tadm.sap_status, tadd.status, tadp.sap_status, tadm2.sap_status)) as &quot;สถานะgenSUN&quot; ,coalesce((case when cec.payment_user_type = &#39;ACCOUNTING&#39; or cec.payment_user_type is null then tapl.event_type end)) &quot;dashboardบัญชี&quot; ,coalesce((case when cec.payment_user_type = &#39;FINANCIAL&#39; then tapl.event_type end)) &quot;dashboardการเงิน&quot; ,coalesce(tadm.reference_number, tadd.reference_number, tadp.reference_number, tadm2.reference_number) as &quot;reference_number&quot; from tx_reconcile_stats trs left join (select * from tx_adwpc_process_log where id in (select max(id) from tx_adwpc_process_log group by system_key)) tapl on trs.system_key = tapl.system_key left join tx_manual_oper_mappingetl tmom on tapl.id = tmom.tx_adwpc_process_log_id left join tx_manual_oper tmo on tmom.tx_manual_oper_id = tmo.id left join cf_manual_oper cmo on tmo.manual_oper_code = cmo.manual_oper_code left join tx_adwpc_dashboard_manual tadm on tapl.tx_adwpc_dashboard_manual_id = tadm.id left join tx_adwpc_dashboard_daily tadd on tapl.tx_adwpc_dashboard_daily_id = tadd.id left join tx_adwpc_dashboard_payment tadp on tapl.tx_adwpc_dashboard_payment_id = tadp.id left join tx_adwpc_dashboard_monthly tadm2 on tapl.tx_adwpc_dashboard_monthly_id = tadm2.id inner join cf_event_code cec on trs.event_code = cec.event_code inner join cf_event_flow cef on cec.sub_system_group = cef.sub_system_group inner join cf_department cd on cef.department_code = cd.department_code inner join cf_event_group ceg on tapl.event_group = ceg.event_group -------------------------------------------------------------------------------- -- กรณี 1 เลือกสถานะรายการเป็น &quot;ทั้งหมด&quot; where trs.status &lt;&gt; &#39;C&#39; and not exists (select trs1.id from tx_reconcile_stats trs1 where trs.id = trs1.id and trs1.status = &#39;R&#39; and date(trs1.process_date) &gt; current_date) -- กรณี 2 เลือกสถานะรายการเป็น &quot;SUCCESS&quot; where trs.status = &#39;S&#39; and trs.source_amount = tapl.edw_reconcile_amount and (tapl.status in (&#39;SUCCESS&#39;) or (tapl.status in (&#39;CANCEL&#39;) and trs.event_code not in (&#39;UL_D_00&#39;,&#39;UL_D_01&#39;,&#39;UL_D_02&#39;))) -- กรณี 3 เลือกสถานะรายการเป็น &quot;FAIL&quot; where ( (trs.status = &#39;R&#39; or trs.source_amount &lt;&gt; tapl.edw_reconcile_amount or tapl.status not in (&#39;SUCCESS&#39;,&#39;CANCEL&#39;)) or ((trs.status = &#39;S&#39; or trs.source_amount = tapl.edw_reconcile_amount) and tapl.status in (&#39;CANCEL&#39;) and trs.event_code in (&#39;UL_D_00&#39;,&#39;UL_D_01&#39;,&#39;UL_D_02&#39;)) ) and not exists (select trs1.id from tx_reconcile_stats trs1 where trs.id = trs1.id and trs1.status = &#39;R&#39; and date(trs1.process_date) &gt; current_date) -------------------------------------------------------------------------------- and cd.department_code in (&lt;departmentCodeList&gt;) and trs.system in (&lt;systemList&gt;) and cmo.manual_oper_code in (&lt;manualOperCodeList&gt;) and trs.event_code in (&lt;eventCodeList&gt;) and date(trs.operation_approved_date) between :oad_from_date and :oad_to_date and date(trs.accounting_date) between :ad_from_date and :ad_to_date and date(trs.requested_payment_date) between :rpd_from_date and :rpd_to_date order by date(trs.operation_approved_date), trs.accounting_date, cf_department.department_code, cmo.manual_oper_display_name, cec.event_code_name, reconcile_status ;]]> ตัวอย่าง sql (รวมกรณี Daily เก่า