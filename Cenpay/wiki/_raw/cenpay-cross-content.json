9A%E0%B8%9A_%20Interface%20File%20AP%20Layout%20For%20No%20VAT_V1.8%20Update%2012-2-2013.docx?version=1&modificationDate=1585041287256&api=v2\",\"/download/attachments/695730728/image2020-5-13%2013%3A34%3A51.png?version=1&modificationDate=1589351688682&api=v2\",\"/download/attachments/685671064/2019-10-10_10-13-14.png?version=1&modificationDate=1570677274895&api=v2\",\"/download/attachments/681246852/error001.jpg?version=1&modificationDate=1569402142980&api=v2\",\"/download/attachments/681246852/error002.jpg?version=1&modificationDate=1569402158680&api=v2\",\"/download/attachments/681246852/error003.jpg?version=1&modificationDate=1569407719414&api=v2\",\"/download/attachments/685671064/error007.jpg?version=1&modificationDate=1569830339611&api=v2\",\"/download/attachments/681246852/error004.jpg?version=1&modificationDate=1569460248588&api=v2\",\"/download/attachments/685671064/warning004.jpg?version=1&modificationDate=1570526196862&api=v2\",\"/download/attachments/685671064/warning005.jpg?version=1&modificationDate=1570530251981&api=v2\"]},{\"id\":\"1001751467\",\"status\":200,\"space\":\"RDSCLMS\",\"spaceName\":\"โครงการ New Claim System\",\"title\":\"Step การสร้าง Template SMS\",\"url\":\"/pages/viewpage.action?pageId=1001751467\",\"md\":\"1. เพิ่ม sms_code,sms_message ที่ตาราง [cf_ncl_sms](/display/RDSCLMS/cf_ncl_sms) และ [Master Data](https://docs.google.com/spreadsheets/d/1DPfytPFFleBW_qSS2QLRTPXf17qzdap8qudVmTgKkeA/edit?pli=1#gid=502073414) (ตารางของระบบ CMS เอง)\\n2. เพิ่ม Template ที่ [02. SMS Template Specification](/display/RDSSMSGW/02.+SMS+Template+Specification)\\n\\n| Column | Data |\\n|---|---|\\n| Catagory | Claim Management System |\\n| Catagory short code | CMS |\\n| วัตถุประสงค์ | ตามหัวข้อ SMS |\\n| System name/File Shared | ตามหัวข้อ SMS |\\n| Sender | OceanLife |\\n| Username | Production : postnclaim@oceanlifeUAT : postnccuat@oceanlife |\\n| SMS Host | bulksms.sc4msg |\\n| ตัวอย่าง SMS | ตามหัวข้อ SMS |\\n\\n3. เปิด JIRA และ ITD แจ้งพี่เปิ้ล,พี่บ๊อบ ตามตัวอย่าง (ให้ JIRA 2 ตัว Relate กันด้วย)\\n[![img](http://jira.thaisamut.co.th/images/icons/issuetypes/task.png)ESB-3691](http://jira.thaisamut.co.th/browse/ESB-3691) - ขอเพิ่ม SMS Category สำหรับโครงการ CMS แจ้งผลการรับเรื่องจากสาขา (![img](http://jira.thaisamut.co.th/images/icons/statuses/closed.png) Closed) และ [![img](http://jira.thaisamut.co.th/images/icons/issuetypes/story.png)ITD-63648](http://jira.thaisamut.co.th/browse/ITD-63648) - ขอเพิ่ม Config Account SMS สำหรับโครงการ CMS (![img](http://jira.thaisamut.co.th/images/icons/statuses/resolved.png) Resolved)\\n4.เพิ่มการ Config ที่ระบบ CSMS (epirusapp)\\nEx. [![img](http://jira.thaisamut.co.th/images/icons/issuetypes/task.png)NCLS-5226](http://jira.thaisamut.co.th/browse/NCLS-5226) - [CMS] Initial ข้อมูล SMS Category ที่ระบบ CSMS (![img](http://jira.thaisamut.co.th/images/icons/statuses/resolved.png) Resolved) และ Update sms_catregory ที่ wiki [http://wiki.thaisamut.co.th/pages/viewpage.action?title=sms_category&spaceKey=CSMS](http://wiki.thaisamut.co.th/pages/viewpage.action?title=sms_category&spaceKey=CSMS)\",\"links\":[{\"text\":\"cf_ncl_sms\",\"href\":\"/display/RDSCLMS/cf_ncl_sms\"},{\"text\":\"Master Data\",\"href\":\"https://docs.google.com/spreadsheets/d/1DPfytPFFleBW_qSS2QLRTPXf17qzdap8qudVmTgKkeA/edit?pli=1#gid=502073414\"},{\"text\":\"02. SMS Template Specification\",\"href\":\"/display/RDSSMSGW/02.+SMS+Template+Specification\"},{\"text\":\"ESB-3691\",\"href\":\"http://jira.thaisamut.co.th/browse/ESB-3691\"},{\"text\":\"ITD-63648\",\"href\":\"http://jira.thaisamut.co.th/browse/ITD-63648\"},{\"text\":\"NCLS-5226\",\"href\":\"http://jira.thaisamut.co.th/browse/NCLS-5226\"},{\"text\":\"http://wiki.thaisamut.co.th/pages/viewpage.action?title=sms_category&spaceKey=CSMS\",\"href\":\"http://wiki.thaisamut.co.th/pages/viewpage.action?title=sms_category&spaceKey=CSMS\"}],\"atts\":[]},{\"id\":\"1335525699\",\"status\":200,\"space\":\"RDSCLMS\",\"spaceName\":\"โครงการ New Claim System\",\"title\":\"21_01 Process ส่งรายการเข้า ระบบ Payment Management\",\"url\":\"/pages/viewpage.action?pageId=1335525699\",\"md\":\"TOC\\n[ [Objectives](#id-21_01Processส่งรายการเข้าระบบPaymentManagement-Objectives) ] [ [Process Overview](#id-21_01Processส่งรายการเข้าระบบPaymentManagement-ProcessOverview) ] [ [Input](#id-21_01Processส่งรายการเข้าระบบPaymentManagement-Input) ] [ [Process Description](#id-21_01Processส่งรายการเข้าระบบPaymentManagement-ProcessDescription) ]\\n\\n## Objectives\\n\\nProcess ส่งรายการเข้า ระบบ Payment Management\\n\\n## Process Overview\\n\\n## Input\\n\\n**Input :**\\nรายละเอียด\\n\\n| Name | Type | Description | Example | Validation |\\n|---|---|---|---|---|\\n| batchIdbatchNo | numericString | รหัส batch ตรวจจ่ายbatch ตรวจจ่าย | BT-20250306-00003 | Mandatory |\\n| batchPaymentTypeCode | String | ประเภท Batch นำส่ง | CL_H | Mandatory |\\n\\n## Process Description\\n\\n**ส่งข้อมูลรายการจ่ายทั้งหมด เข้าระบบ PayM**\\nรายละเอียดการส่งเข้าระบบ PayM\\n**Step1. ดึงข้อมูลรายการทำจ่าย**\\n1.1 กรณี ประเภท Batch นำส่ง เป็น สินไหมจ่ายลูกค้า (@batchPaymentTypeCode = CL_H)\\n\\n| Table | Relationship of Table | Condition | Description |\\n|---|---|---|---|\\n| [tx_ncl_pay_batch](/display/RDSCLMS/tx_ncl_pay_batch) |   | [tx_ncl_pay_batch](/display/RDSCLMS/tx_ncl_pay_batch).id = @batch_id @batchNo | ข้อมูลรวมรายการเป็นชุดข้อมูลเพื่อเสนออนุมัติ(Batch นำส่ง) |\\n| [tx_ncl_pay_batch_transfer](/display/RDSCLMS/tx_ncl_pay_batch_transfer) | [tx_ncl_pay_batch_transfer](/display/RDSCLMS/tx_ncl_pay_batch_transfer).batch_id = [tx_ncl_pay_batch](/display/RDSCLMS/tx_ncl_pay_batch).id | [tx_ncl_pay_batch_transfer](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_pay_batch_transfer).send_paid_flag is Falseor [tx_ncl_pay_batch_transfer](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_pay_batch_transfer).send_paid_flag is Null | ข้อมูล Batch โอนเงิน |\\n| [tx_ncl_pay_pycust_tran_total_pay](/display/RDSCLMS/tx_ncl_pay_pycust_tran_total_pay) | [tx_ncl_pay_pycust_tran_total_pay](/display/RDSCLMS/tx_ncl_pay_pycust_tran_total_pay).transfer_id = [tx_ncl_pay_batch_transfer](/display/RDSCLMS/tx_ncl_pay_batch_transfer).id |   | ข้อมูลรายการรวมจ่ายหมายเหตุ : รายการที่ลงตาราง เป็นรายการที่ [tx_ncl_pay_pycust_tran](/display/RDSCLMS/tx_ncl_pay_pycust_tran).verify_flag ของรายการภายใต้สินไหมเดียวกัน เป็น Y ทั้งหมดเท่านั้น |\\n| [tx_ncl_pay_pycust_tran](/display/RDSCLMS/tx_ncl_pay_pycust_tran) | [tx_ncl_pay_pycust_tran](/display/RDSCLMS/tx_ncl_pay_pycust_tran).total_paid_customer_id = [tx_ncl_pay_pycust_tran_total_pay](/display/RDSCLMS/tx_ncl_pay_pycust_tran_total_pay).id |   | ข้อมูลรายการจ่ายเงิน |\\n| [tx_ncl_apv_header](/display/RDSCLMS/tx_ncl_apv_header) | [tx_ncl_apv_header](/display/RDSCLMS/tx_ncl_apv_header).claim_no = [tx_ncl_pay_pycust_tran](/display/RDSCLMS/tx_ncl_pay_pycust_tran).claim_number |   | ข้อมูลวันที่สินไหมรับเรื่อง |\\n| [ms_ncl_bank](http://wiki.thaisamut.co.th/display/RDSCLMS/ms_ncl_bank) | Left join [ms_ncl_bank](http://wiki.thaisamut.co.th/display/RDSCLMS/ms_ncl_bank).id = [tx_ncl_pay_pycust_tran_total_pay](/display/RDSCLMS/tx_ncl_pay_pycust_tran_total_pay).account_bank_id |   | ข้อมูลธนาคาร |\\n| [tx_ncl_apv_address](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_apv_address) | Left Join[tx_ncl_apv_address](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_apv_address).claim_no = [tx_ncl_pay_pycust_tran](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_pay_pycust_tran).claim_no_refand [tx_ncl_apv_address](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_apv_address).beneficiary_id = [tx_ncl_pay_pycust_tran](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_pay_pycust_tran).payee_id | [tx_ncl_apv_address](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_apv_address).address_type_code = POST | ที่อยู่ของผู้รับเงิน |\\n| [tx_ncl_reg_policy](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_reg_policy) | inner joinกรณี ช่องทางรับเรื่อง ไม่ใช่ Fax Claim ([tx_ncl_pay_pycust_tran](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_pay_pycust_tran).registration_method <> FCLM ) ใช้เงื่อนไขนี้[tx_ncl_reg_policy](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_reg_policy).registration_header_id = registration_header_idand [tx_ncl_reg_policy](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_reg_policy).id = [tx_ncl_apv_header](/display/RDSCLMS/tx_ncl_apv_header).policy_idกรณี ช่องทางรับเรื่อง เป็น Fax Claim ([tx_ncl_pay_pycust_tran](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_pay_pycust_tran).registration_method = FCLM ) ใช้เงื่อนไขนี้[tx_ncl_reg_policy](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_reg_policy).batch_no = [tx_ncl_apv_header](/display/RDSCLMS/tx_ncl_apv_header).registration_no and [tx_ncl_reg_policy](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_reg_policy).id = [tx_ncl_apv_header](/display/RDSCLMS/tx_ncl_apv_header).policy_id |   |   |\\n| [tx_ncl_reg_policy_coverage](/display/RDSCLMS/tx_ncl_reg_policy_coverage) | inner join [tx_ncl_reg_policy_coverage](/display/RDSCLMS/tx_ncl_reg_policy_coverage).policy_id = [tx_ncl_reg_policy](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_reg_policy).id | [tx_ncl_reg_policy_coverage](/display/RDSCLMS/tx_ncl_reg_policy_coverage).flag_baseplan = 1 |   |\\n\\n1.2 กรณี ประเภท Batch นำส่ง เป็น สินไหมจ่ายโรงพยาบาล ( @batchPaymentTypeCode = CL_CH)\\n- ดึงข้อมูลการจ่าย\\n\\n| Table | Relationship of Table | Condition | Description |\\n|---|---|---|---|\\n| [tx_ncl_pay_batch](/display/RDSCLMS/tx_ncl_pay_batch) |   | [tx_ncl_pay_batch](/display/RDSCLMS/tx_ncl_pay_batch).id = @batch_id @batchNo | ข้อมูลรวมรายการเป็นชุดข้อมูลเพื่อเสนออนุมัติ(Batch นำส่ง) |\\n| [tx_ncl_pay_batch_transfer](/display/RDSCLMS/tx_ncl_pay_batch_transfer) | [tx_ncl_pay_batch_transfer](/display/RDSCLMS/tx_ncl_pay_batch_transfer).batch_id = [tx_ncl_pay_batch](/display/RDSCLMS/tx_ncl_pay_batch).id | [tx_ncl_pay_batch_transfer](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_pay_batch_transfer).send_paid_flag is Falseor [tx_ncl_pay_batch_transfer](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_pay_batch_transfer).send_paid_flag is Null | ข้อมูล Batch โอนเงิน |\\n| [tx_ncl_pay_pyhosp_tran](/display/RDSCLMS/tx_ncl_pay_pyhosp_tran) | [tx_ncl_pay_pyhosp_tran](/display/RDSCLMS/tx_ncl_pay_pyhosp_tran).transfer_id = [tx_ncl_pay_batch_transfer](/display/RDSCLMS/tx_ncl_pay_batch_transfer).id | [tx_ncl_pay_pyhosp_tran](/display/RDSCLMS/tx_ncl_pay_pyhosp_tran).verify_flag = Y | ข้อมูลรายการจ่ายเงิน รพ. |\\n| ms_ncl_hospital | inner join ms_ncl_hospital.hospital_code = [tx_ncl_pay_pyhosp_tran](/display/RDSCLMS/tx_ncl_pay_pyhosp_tran).payee_code |   | ข้อมูลรพ. |\\n| ms_ncl_hospital_account | left join ms_ncl_hospital_account .hospital_id =ms_ncl_hospital.id |   | ข้อมูลการเงินและบัญชีของรพ. |\\n| ms_ncl_hospital_address | left join ms_ncl_hospital_address.hospital_id = ms_ncl_hospital_account.hospital_idand ms_ncl_hospital_address.address_type_code = ms_ncl_hospital_account.address_type_code |   | ข้อมูลที่อยู่รพ. |\\n| [ms_ncl_bank](http://wiki.thaisamut.co.th/display/RDSCLMS/ms_ncl_bank) | Left join [ms_ncl_bank](http://wiki.thaisamut.co.th/display/RDSCLMS/ms_ncl_bank).id = [tx_ncl_pay_pyhosp_tran](/display/RDSCLMS/tx_ncl_pay_pyhosp_tran).account_bank_id |   | ข้อมูลธนาคาร |\\n\\n- ดึงรายละเอียดวางบิล\\n\\n| Table | Relationship of Table | Condition | Description |\\n|---|---|---|---|\\n| [tx_ncl_bill_header](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_bill_header) |   | [tx_ncl_bill_header](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_bill_header).batch_billing_no = [tx_ncl_pay_pyhosp_tran](/display/RDSCLMS/tx_ncl_pay_pyhosp_tran).billing_number |   |\\n| [tx_ncl_bill_detail](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_bill_detail) | [tx_ncl_bill_detail](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_bill_detail).batch_billing_no =[tx_ncl_bill_header](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_bill_header).batch_billing_no | [tx_ncl_bill_detail](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_bill_detail).checkbox = 1 | ข้อมูลรายละเอียดรายการวางบิล (Claim No. ที่วางบิลภายใต้ Batch Billing No.)Edit 15/12/2566 ปรับแก้เงื่อนไข เพิ่มดึงเฉพาะ สถานะพิจารณา เป็น ตรวจสอบสำเร็จ (VTS) |\\n\\n- ดึงข้อมูลกรมธรรม์ ของรายการวางบิล ดึงนี้\\n\\n| ประเภทกรมธรรม์ | ช่องทางรับเรื่อง | ดึงข้อมูล |\\n|---|---|---|\\n| [tx_ncl_bill_detail](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_bill_detail).policy_type <> GROUP and PAGROUP | [tx_ncl_bill_detail](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_bill_detail).claim_channel = FCLM (Fax Claim) | ข้อมูลกรมธรรม์ของ ประกันเดียว ช่องทาง Fax Claim**Query :** <![CDATA[select * from tx_ncl_fax_relation_policy b inner join tx_ncl_fax_header c on c.batch_no = b.batch_no inner join tx_ncl_fax_detail d on d.batch_no = b.batch_no inner join tx_ncl_reg_policy e on e.batch_no = b.batch_no and e.policy_no = b.policy_no inner join tx_ncl_reg_policy_coverage f on f.batch_no = b.batch_no and f.policy_no = b.policy_no and f.coverage_code = b.coverage_code and f.claim_type_code = b.claim_type_code and f.flag_baseplan = 0 where b.claim_no =: @tx_ncl_bill_detail.claim_no ;]]> |\\n| [tx_ncl_bill_detail](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_bill_detail).policy_type <> GROUP and PAGROUP | [tx_ncl_bill_detail](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_bill_detail).claim_channel <> FCLM (Fax Claim) | ข้อมูลกรมธรรม์ของ ประกันเดียว ช่องทาง Web Claim&API**Query :** <![CDATA[select * from tx_wcl_booking_medical_expenses b left join tx_ncl_web_header c on c.booking_no = b.booking_no left join tx_wcl_ord_policy d on d.policy_no =b.policy_no left join tx_wcl_pa_policy e on e.policy_no = b.policy_no where c.claim_no =: @tx_ncl_bill_detail.claim_no ;]]> |\\n| [tx_ncl_bill_detail](http://wiki.thaisamut.co.th/display/RDSCLMS/tx_ncl_bill_detail).policy_type = GROUP Or PAGROUP | - | ข้อมูลกรมธรรม์ประกันกลุ่ม**Query :** <![CDATA[select * from tx_ncl_group_claim where notify_no = : @tx_ncl_bill_detail.claim_no ;]]> |\\n\