ual_oper_id union all select sum(coalesce(amount,0)) as amount from tx_income_ov_rider where income_type in (&#39;SUPERVISOR_CONSERVATION&#39; --50551104 ,&#39;MANAGER_CONSERVATION_SECOND_YEAR&#39;,&#39;LEAD_SALES_CONSERVATION_SECOND_YEAR&#39; --50551105 ,&#39;SUPERVISOR_BONUS_NEW_SUPERVISOR&#39; --50551125 ,&#39;SUPERVISOR_BONUS&#39;,&#39;LEAD_SALES_SUM_BENEFIT&#39;--50551126 added by punyata.te 26/06/2569 ref: UR20260143 add income_type = &#39;LEAD_SALES_SUM_BENEFIT&#39; ,&#39;SUPERVISOR_RECRUITMENT&#39;--50551127 ,&#39;SUPERVISOR_RECRUITMENT_AGENT&#39;--50551128 -- added by punyata.te 17/12/2568 ref:UR20250308 เพิ่ม Income Type ของตำแหน่ง HEAD_MANAGER ,&#39;SALES_MANAGER_CONSERVATION_SECOND_YEAR&#39;,&#39;HEAD_MANAGER_CONSERVATION_SECOND_YEAR&#39;--50551212 ,&#39;MANAGER_IMPROVEMENT&#39;,&#39;LEAD_SALES_IMPROVEMENT&#39;--50551215 ,&#39;ASST_MANAGER_TEAM_MANAGEMENT&#39;,&#39;MANAGER_TEAM_MANAGEMENT&#39;,&#39;SALES_MANAGER_TEAM_MANAGEMENT&#39;,&#39;LEAD_SALES_TEAM_MANAGEMENT&#39;,&#39;HEAD_MANAGER_TEAM_MANAGEMENT&#39;--50551216 ,&#39;MANAGER_RECRUITMENT&#39;,&#39;MANAGER_RECRUITMENT_ASST_TO_MANAGER&#39;,&#39;SALES_MANAGER_RECRUITMENT&#39;,&#39;LEAD_SALES_RECRUITMENT&#39;,&#39;LEAD_SALES_RECRUITMENT_LEAD_SALES&#39;,&#39;MANAGER_RECRUITMENT_NEW&#39;,&#39;MANAGER_RECRUITMENT_LEAD_SALES&#39;,&#39;HEAD_MANAGER_RECRUITMENT&#39;--50551217 ,&#39;AGENT_OFFICE_MANAGEMENT_TEAM_FIRST_YEAR&#39;--50551218 ,&#39;AGENT_OFFICE_MANAGEMENT_TEAM&#39;--50551219 ,&#39;AGENT_OFFICE_MANAGEMENT_TEAM_FIRST_YEAR_3&#39;--50551221 ) and tx_manual_oper_id = :manual_oper_id --183765 union all select sum(coalesce(amount,0)) as amount from tx_income_gl_account_posting where gl_code in (&#39;50590020&#39;,&#39;50590021&#39;,&#39;50590030&#39;) and tx_manual_oper_id = :manual_oper_id --183765 union all --50551210,50551212,50551216,50551220,50590021 select sum(coalesce(amount,0)) as amount from tx_income_ov_rider_kpi where sales_type in (&#39;SALES_MANAGER&#39;,&#39;KPI&#39;) and tx_manual_oper_id = 