ูลบัญชี-Input) ] [ [Output](#WSสำหรับดึงสถานะETLตอนประมวลผลข้อมูลบัญชี-Output) ]\\n\\n## Overview\\n\\n- `Web Service สำหรับดึงสถานะ ETL ตอนประมวลผลข้อมูลบัญชี`\\n\\n## Protocol\\n\\nIcon\\n<REST>\\n\\n## Operation\\n\\nrefer : [ESB WebService Design Pattern](/display/IEA/ESB+WebService+Design+Pattern)\\nMSA-ADWETL\\nURL : /thaisamut/rs/adwetl/v2/adwprocess/\\nIcon\\nTYPE : <inquiry>\\n\\n## Input\\n\\n<แสดงข้อมูล Parameter ที่ต้องการ>\\n\\n| Name | Type | Description | Example | Validation | Mandatory | Remark |\\n|---|---|---|---|---|---|---|\\n| systemName | String | ชื่อระบบ |   | not null | M | ค่าที่ส่งมาควรอยู่ใน [cf_event_flow](/display/RDSADW/cf_event_flow).system |\\n| systemKey | String | Key ที่ใช้ทำงานประมวลผล ETL |   | not null | M |   |\\n\\nProcess\\n1. query ข้อมูลเหมือน /thaisamut/rs/adwetl/v1/adwprocess/ แต่เพิ่มการส่งข้อมูลด้านล่างไปเพิ่มหากพบข้อมูล dashboardIdLongid ของตาราง tx_adwpc_dashboard_xxxxreferenceNumberStringreferenceNumber ของตาราง DashboardedwReconcileAmountBigDecimalยอด EDW Reconcile AmounttxAdwpcProcessLogIdLongid ของตาราง [tx_adwpc_process_log](http://wiki.thaisamut.co.th/display/RDSADW/tx_adwpc_process_log)drAmountBigDecimalยอด DRcrAmountBigDecimalยอด CR\\n\\n## Output\\n\\n`<แสดงข้อมูลที่จะได้รับจาก service นี้>`\\n\\n| Name | Type | Description | Example |\\n|---|---|---|---|\\n| txAdwpcProcessLogId | Long | id ของตาราง [tx_adwpc_process_log](/display/RDSADW/tx_adwpc_process_log) |   |\\n| accountingDate | Date | วันที่บันทึกบัญชี |   |\\n| branchNo | String | สาขาบันทึกบัญชี |   |\\n| systemName | String | ชื่อระบบ |   |\\n| status | ProcessLogStatusEnum | สถานะ Process Log |   |\\n| errorMessage | String | ข้อความผิดพลาดจาก Process Log |   |\\n| createdDate | Date | วันเวลาที่สร้าง ProcessLog |   |\\n| createdBy | String | ผู้สร้าง ProcessLog |   |\\n| updatedDate | Date | วันเวลาที่แก้ไขล่าสุด ProcessLog |   |\\n| updatedBy | String | ผู้ที่แก้ไข ProcessLog |   |\\n| totalTimeMs | Long | เวลาที่ใช้ทั้งหมด |   |\\n| systemKey | String | key ที่ใช้คุยกันระหว่างระบบ |   |\\n| dashboardId | Long | id ของตาราง tx_adwpc_dashboard_xxxx |   |\\n| referenceNumber | String | referenceNumber ของตาราง Dashboard |   |\\n| edwReconcileAmount | BigDecimal | ยอด EDW Reconcile Amount |   |\\n| drAmount | BigDecimal | ยอดเงิน DR |   |\\n| crAmount | BigDecimal | ยอดเงิน CR |   |\",\"links\":[{\"text\":\"Overview\",\"href\":\"#WSสำหรับดึงสถานะETLตอนประมวลผลข้อมูลบัญชี-Overview\"},{\"text\":\"Protocol\",\"href\":\"#WSสำหรับดึงสถานะETLตอนประมวลผลข้อมูลบัญชี-Protocol\"},{\"text\":\"Operation\",\"href\":\"#WSสำหรับดึงสถานะETLตอนประมวลผลข้อมูลบัญชี-Operation\"},{\"text\":\"Input\",\"href\":\"#WSสำหรับดึงสถานะETLตอนประมวลผลข้อมูลบัญชี-Input\"},{\"text\":\"Output\",\"href\":\"#WSสำหรับดึงสถานะETLตอนประมวลผลข้อมูลบัญชี-Output\"},{\"text\":\"ESB WebService Design Pattern\",\"href\":\"/display/IEA/ESB+WebService+Design+Pattern\"},{\"text\":\"cf_event_flow\",\"href\":\"/display/RDSADW/cf_event_flow\"},{\"text\":\"tx_adwpc_process_log\",\"href\":\"http://wiki.thaisamut.co.th/display/RDSADW/tx_adwpc_process_log\"},{\"text\":\"tx_adwpc_process_log\",\"href\":\"/display/RDSADW/tx_adwpc_process_log\"}],\"atts\":[]},{\"id\":\"1284571237\",\"status\":200,\"space\":\"RDSADW\",\"spaceName\":\"โครงการ Accounting Data Warehouse\",\"title\":\"WS สำหรับดึง SUN Status กลับไป Stamp ระบบต้นทาง\",\"url\":\"/pages/viewpage.action?pageId=1284571237\",\"md\":\"[ [Overview](#WSสำหรับดึงSUNStatusกลับไปStampระบบต้นทาง-Overview) ] [ [Protocol](#WSสำหรับดึงSUNStatusกลับไปStampระบบต้นทาง-Protocol) ] [ [Operation](#WSสำหรับดึงSUNStatusกลับไปStampระบบต้นทาง-Operation) ] [ [Input](#WSสำหรับดึงSUNStatusกลับไปStampระบบต้นทาง-Input) ] [ [Output](#WSสำหรับดึงSUNStatusกลับไปStampระบบต้นทาง-Output) ]\\n\\n## Overview\\n\\n- `Web Service สำหรับดึง SUN Status กลับไป Stamp ระบบต้นทาง`\\n\\n## Protocol\\n\\nIcon\\n<REST>\\n\\n## Operation\\n\\nrefer : [ESB WebService Design Pattern](/display/IEA/ESB+WebService+Design+Pattern)\\nMSA-ADWETL\\nURL : /thaisamut/rs/adwetl/v2/accountingdashboard/inquiry/\\nIcon\\nTYPE : <inquiry>\\n\\n## Input\\n\\n<แสดงข้อมูล Parameter ที่ต้องการ>\\nList ของข้อมูลตามด้านล่าง ขนาดไม่เกิน 20\\n\\n| Name | Type | Description | Example | Validation | Mandatory | Remark |\\n|---|---|---|---|---|---|---|\\n| referenceNumber | String | Reference Number ของ EDW |   | not null | M |   |\\n\\nProcess\\n1. นำ referenceNumer ไปหาข้อมูลตาราง dashboard (tx_adwpc_dashboard_payment, tx_adwpc_dashboard_manual,tx_adwpc_dashboard_monthly,tx_adwpc_dashboard_daily)\\n2. return ข้อมูลตาม Output ด้านล่าง\\n\\n## Output\\n\\n`<แสดงข้อมูลที่จะได้รับจาก service นี้>`\\nList ของข้อมูลตามด้านล่าง\\n\\n| Name | Type | Description | Condition Mapping | Example |\\n|---|---|---|---|---|\\n| dashboardId | Long | id ของตาราง Dashboard |   |   |\\n| dashboardType | String | ประเภท Dashboard | MANUALMONTHLYDAILYPAYMENT |   |\\n| eventCode | String | รหัสธุรกรรม (Transaction Code) ที่ระบุประเภทของรายการทางบัญชี |   | \\\"INC001\\\", \\\"PAY005\\\" |\\n| eventGroup | String | รหัสกลุ่มธุรกรรม 8 กลุ่ม เพื่อจัดหมวดหมู่ของ eventCode |   | \\\"INC\\\", \\\"EXP\\\" |\\n| drAmount | BigDecimal | ยอดรวมเงินทางด้านเดบิต (Debit) ของรายการ |   | new BigDecimal(\\\"1500.50\\\") |\\n| crAmount | BigDecimal | ยอดรวมเงินทางด้านเครดิต (Credit) ของรายการ |   | new BigDecimal(\\\"1500.50\\\") |\\n| referenceNumber | String | เลขที่อ้างอิงของเอกสารหรือรายการในระบบ Dashboard |   | \\\"ED202509010001\\\" |\\n| createdBy | String | ชื่อผู้ใช้งาน (username) ที่สร้างรายการ |   | \\\"user_01\\\" |\\n| createdDate | Date | วันที่และเวลาที่สร้างรายการ |   | LocalDateTime.parse(\\\"2025-09-17T10:00:00\\\") |\\n| updatedBy | String | ชื่อผู้ใช้งาน (username) ที่แก้ไขรายการล่าสุด |   | \\\"user_02\\\" |\\n| updatedDate | Date | วันที่และเวลาที่แก้ไขรายการล่าสุด |   | LocalDateTime.parse(\\\"2025-09-18T11:30:00\\\") |\\n| remark | String | หมายเหตุเพิ่มเติมเกี่ยวกับรายการ |   | \\\"ค่าใช้จ่ายเดินทาง\\\" |\\n| sunPath | String | Path สำหรับใช้สร้างไฟล์ Text เพื่อส่งออก โดยระบุว่าเป็นรายการ Auto (A) หรือ Manual (M) |   | \\\"A\\\" |\\n| accountingDate | Date | วันที่บันทึกบัญชี (Accounting Date) |   | LocalDate.parse(\\\"2025-09-16\\\") |\\n| postingDate | Date | วันที่บันทึกบัญชีที่ทีมบัญชีเป็นผู้กำหนด (Posting Date) | Daily : ไม่มีข้อมูล | LocalDate.parse(\\\"2025-09-30\\\") |\\n| dashboardStatus | String | สถานะของรายการในระบบ Dashboard | Daily :INPROGRESSERRORIMBALANCEWAIT_MANUAL_SAP WAIT_SAP | ERRORPROCESSINGWAIT_APPROVEAPPROVEDREJECTEDCANCEL |\\n| sunStatus | String | สถานะการส่งข้อมูลไปยังระบบ Sun | Daily :SUCCESSSAP_PROCESSING SAP_ERROR SUN_INVALID | SUCCESSSAP_PROCESSINGSAP_ERROR SUCCESSEDW_POSTINGEDW_ERRORSUN_INVALID |\\n| supportBookingKey | String | Key สำหรับดึงข้อมูล Support Booking | Daily : ไม่มีข้อมูล | \\\"KEY12345\\\" |\\n| processlogStatus | ProcessLogStatusEnum | สถานะ Process Log |   | LANDING WAITETL PREPROCESS_ETL EXTRACT_IMPORT TRANSFORM JOINAGG RECONCILE ACCAPPROVED SENDTOADW WAIT_SENDTOADW SUCCESS CANCEL |\",\"links\":[{\"text\":\"Overview\",\"href\":\"#WSสำหรับดึงSUNStatusกลับไปStampระบบต้นทาง-Overview\"},{\"text\":\"Protocol\",\"href\":\"#WSสำหรับดึงSUNStatusกลับไปStampระบบต้นทาง-Protocol\"},{\"text\":\"Operation\",\"href\":\"#WSสำหรับดึงSUNStatusกลับไปStampระบบต้นทาง-Operation\"},{\"text\":\"Input\",\"href\":\"#WSสำหรับดึงSUNStatusกลับไปStampระบบต้นทาง-Input\"},{\"text\":\"Output\",\"href\":\"#WSสำหรับดึงSUNStatusกลับไปStampระบบต้นทาง-Output\"},{\"text\":\"ESB WebService Design Pattern\",\"href\":\"/display/IEA/ESB+WebService+Design+Pattern\"}],\"atts\":[]},{\"id\":\"1320780452\",\"status\":200,\"space\":\"RDSPLP\",\"spaceName\":\"Partial Loan Payment (New Loan System)\",\"title\":\"MSA-04- บันทึกรับคืนหนี้สินเงินกู้\",\"url\":\"/pages/viewpage.action?pageId=1320780452\",\"md\":\"[ [Overview](#MSA-04-บันทึกรับคืนหนี้สินเงินกู้-Overview) ] [ [Protocol](#MSA-04-บันทึกรับคืนหนี้สินเงินกู้-Protocol) ] [ [Operation](#MSA-04-บันทึกรับคืนหนี้สินเงินกู้-Operation) ] [ [Input](#MSA-04-บันทึกรับคืนหนี้สินเงินกู้-Input) ] [ [Process](#MSA-04-บันทึกรับคืนหนี้สินเงินกู้-Process) ] [ [Output](#MSA-04-บันทึกรับคืนหนี้สินเงินกู้-Output) ] [ [Exception](#MSA-04-บันทึกรับคืนหนี้สินเงินกู้-Exception) ] [ [Example Input & Output](#MSA-04-บันทึกรับคืนหนี้สินเงินกู้-ExampleInput&Output) ]\\n\\n## Overview\\n\\nมีหน้าที่รับข้อมูลเพื่อบันทึกการรับชำระเงินกู้ตามกรมธรรม์ โดยรองรับการชำระทั้งแบบเงินกู้ชำระเบี้ยอัตโนมัติ (APL) และเงินกู้ตามกรมธรรม์ (PL) ในคราวเดียว\\n- ปรับปรุงยอดหนี้ในระบบ AS400 ให้เป็นปัจจุบัน\\n- ออกเลขที่ใบเสร็จรับชำระเงินกู้\\n- เตรียมข้อมูลสำหรับงานเบื้องหลัง (Post-processing) เช่น การสร้าง E-Receipt และการบันทึกบัญชี\\n**ระบบที่เรียกใช้**\\n\\n| No | ระบบ | รายละเอียด |\\n|---|---|---|\\n| 1 | Cenpay | บันทึกรับคืนเงินกู้จากเงินผลประโชน์และอิ่นๆ |\\n| 2 | New Loan | บันทึกรับชำระเงินกู้จากหน้าจอบันทึกรับชำระของสาขาและสนญ. |\\n| 3 | CS(Claim System) | บันทึกรับคืนเงินกู้ กรณีเคลมสินไหมมรณกรรม |\\n\\n## Protocol\\n\\nIcon\\n<REST>\\n\\n## Operation\\n\\nrefer : [ESB WebService Design Pattern](/display/IEA/ESB+WebService+Design+Pattern)\\nIcon\\nTYPE : <add>\\n<ชื่อ operation>\\n\\n## Input\\n\\n<แสดงข้อมูล Parameter ที่ต้องการ>\\n\\n| Name | Type | Description | Required/Optional | Example | Validation |\\n|---|---|---|---|---|---|\\n| policyNo | string | เลขที่กรมธรรม์ | Required | 1416233 |   |\\n| policyType | string | ประเภทกรมธรรม์ORD : สามัญIND : อุตสาหกรรม | Required | ORD |   |\\n| paymentDate | Date | วันที่ชำระเงินกู้ (yyyy-mm-dd) | Required |   | ไม่เป็นค่าว่างและรูปแบบถูกต้อง |\\n| paymentOption | string | ประเภทการชำระFLS : ชำระทั้งหมดAPL : ชำระเฉพาะ APLPL : ชำระเฉพาะ PLPAR : ชำระบางส่วน | Required |   |   |\\n| serviceBranch | String | รหัสสาขาบริการ | Required | 2070116 |   |\\n| serviceChannel | string | ช่องทางบริการ Click here to expand... ISR : I-SERVICEOCL : Ocean Line ConnectOCA : Ocean Club AppBRN : สาขาHQ : สนญ.BIL : QR Cross Bank จาก Email/จดหมายCEN : เงินผลประโยชน์/เงินอื่นๆALR : Automatic Loan Repayment | Required |   |   |\\n| paymentChannel | string | วิธีการชำระ Click here to expand... CSH : เงินสดTQR : THAI QRDEP : เงินรับฝากQRB : QR Cross BankAPU : เงินจ่ายคืนทันที APL/APU (Auto Paid Up)RPU : เงินจ่ายคืนทันที RPU (Reduce Paid Up)PSP : เวนคืนกรมธรรม์MAP : ครบกำหนดสัญญาSBP : เงินทรงชีพPPY : เงินบำนาญNLN : กู้ใหม่NLO : กู้เพิ่มCLM : Paid by ClaimLAP : Lapse from APLASU : Auto Surrender | Required |   |   |\\n| depositNo | string | เลขรับฝาก | Optional |   |   |\\n| amount | BigDecimal | จำนวนเงินต่อวิธีการชำระ/เลขรับฝาก | Required |   |   |\\n| paymentMethod | string | ประเภทธุรกรรม Click here to expand... CSH : เงินสดDEP : เงินรับฝากAPU : เงินจ่ายคืนทันที APL/APU (Auto Paid Up)RPU : เงินจ่ายคืนทันที RPU (Reduce Paid Up)PSP : เวนคืนกรมธรรม์MAP : ครบกำหนดสัญญาSBP : เงินทรงชีพPPY : เงินบำนาญNLN : กู้ใหม่NLO : กู้เพิ่มCLM : Paid by ClaimLAP : Lapse from APLASU : Auto Surrender | Required |   |   |\\n| receiptFormat |   | ช่องทางจัดส่งใบเสร็จE : e-ReceiptP : Paper | Required |   |   |\\n| transactionRef | string | เลขอ้างอิงธุรกรรมที่จ่ายCenpay : เลขธุรกรรมCS : ClaimNo | Optional |   |   |\\n| totalPaymentAmount | BigDecimal | ยอดชำระทั้งหมดของการจ่ายครั้งนั้น (รวมยอดจ่ายใบเสร็จเบี้ยด้วยถ้ามี) | Required |   | ต้องมากกว่า 0 |\\n| systemName | String | ชื่อระบบที่เรียก service | Required | CENPAY |   |\\n| userName | String | ชื่อผู้ใช้งาน | Optional | SYSTEM |   |\\n| paymentItems[] | object |   | Require |   | ต้องมีอย่างน้อย 1 รายการ |\\n| loanType | string | ประเภทเงินกู้APLPL | Require |   |   |\\n| paymentAmount | BigDecimal | จำนวนเงินที่รับชำระตามประเภทเงินกู้ | Require |   | ต้องมากกว่า 0 |\\n\\n## Process\\n\\nอ้างอิง [P-03-01 Process การบันทึกรับคืนเงินกู้ (APL+PL)](/pages/viewpage.action?pageId=1319109299)\\n\\n## Output\\n\\n<แสดงข้อมูลที่จะได้รับจาก service นี้>\\n\\n| No | Name | Type | Description | Example |\\n|---|---|---|---|---|\\n| 1 | status | string | สถานะ Result ของการเรียกใช้ serviceSUCCESSERROR | SUCCESS |\\n| 2 | message | string | คำอธิบาย Result | SUCCESS |\\n| 3 | data[] | Object |   |   |\\n| 3.1 | policyNo | string | เลขที่กรมธรรม์ |   |\\n| 3.2 | transactionRef | string | เลขอ้างอิงการชำระ |   |\\n| 3.3 | receiptItems[] | Object |   |   |\\n| 3.3.1 | loanType | string | ประเภทเงินกู้ |   |\\n| 3.3.2 | receiptNo | string | เลขที่ใบเสร็จเงินกู้ |   |\\n\\n## Exception\\n\\n| Error Type | Status | Message | Description / Validation Rule |\\n|---|---|---|---|\\n| Input Validation | ERROR | REQUIRED_FIELD_MISSING | ไม่ได้ส่งฟิลด์บังคับ |\\n| Input Validation | ERROR | INVALID_ENUM_VALUE: [Field] | ค่า Enum ไม่ถูกต้อง |\\n| Business Logic | ERROR | E001: กรมธรรม์สถานะXXX ไม่สามารถชำระด้วย XXX | เงื่อนไขการรับชำระไม่ถูกต้อง |\\n| System Error | ERROR | E002: [Message จาก ESB] | ESB-11 (บันทึกหนี้) ส่ง Error กลับมา |\\n| System Warning | SUCCESS | DEPT_MAPPING_FAILED | หนี้ลดแล้วแต่ Dept.Mapping ไม่สำเร็จ (ต้องซ่อมข้อมูล) |\\n\\n## Example Input & Output\\n\\n1. <ตัวอย่างที่ 1 เช่น การส่งข้อมูลแบบปกติ>\\n\\n```\\n\\n```\\n\\n```\\n\\n```\",\"links\":[{\"text\":\"Overview\",\"href\":\"#MSA-04-บันทึกรับคืนหนี้สินเงินกู้-Overview\"},{\"text\":\"Protocol\",\"href\":\"#MSA-04-บันทึกรับคืนหนี้สินเงินกู้-Protocol\"},{\"text\":\"Operation\",\"href\":\"#MSA-04-บันทึกรับคืนหนี้สินเงินกู้-Operation\"},{\"text\":\"Input\",\"href\":\"#MSA-04-บันทึกรับคืนหนี้สินเงินกู้-Input\"},{\"text\":\"Process\",\"href\":\"#MSA-04-บันทึกรับคืนหนี้สินเงินกู้-Process\"},{\"text\":\"Output\",\"href\":\"#MSA-04-บันทึกรับคืนหนี้สินเงินกู้-Output\"},{\"text\":\"Exception\",\"href\":\"#MSA-04-บันทึกรับคืนหนี้สินเงินกู้-Exception\"},{\"text\":\"Example Input & Output\",\"href\":\"#MSA-04-บันทึกรับคืนหนี้สินเงินกู้-ExampleInput&Output\"},{\"text\":\"ESB WebService Design Pattern\",\"href\":\"/display/IEA/ESB+WebService+Design+Pattern\"},{\"text\":\"P-03-01 Process การบันทึกรับคืนเงินกู้ (APL+PL)\",\"href\":\"/pages/viewpage.action?pageId=1319109299\"}],\"atts\":[]},{\"id\":\"1268121736\",\"status\":200,\"space\":\"RDSOTHCHPAY\",\"spaceName\":\"Other Channel Payment\",\"title\":\"1.17 API นำข้อมูลเข้า Depositpay (รับชำระผ่านทุกช่องทาง ของโครงการ e-Receipt)\",\"url\":\"/pages/viewpage.action?pageId=1268121736\",\"md\":\"[ [Objective](#id-1.17APIนำข้อมูลเข้าDepositpay(รับชำระผ่านทุกช่องทางของโครงการe-Receipt)-Objective) ] [ [Overview](#id-1.17APIนำข้อมูลเข้าDepositpay(รับชำระผ่านทุกช่องทางของโครงการe-Receipt)-Overview) ] [ [Flow การทำงาน](#id-1.17APIนำข้อมูลเข้าDepositpay(รับชำระผ่านทุกช่องทางของโครงการe-Receipt)-Flowการทำงาน) ] [ [Ref FS](#id-1.17APIนำข้อมูลเข้าDepositpay(รับชำระผ่านทุกช่องทางของโครงการe-Receipt)-RefFS) ] [ [Pre-Condition](#id-1.17APIนำข้อมูลเข้าDepositpay(รับชำระผ่านทุกช่องทางของโครงการe-Receipt)-Pre-Condition) ] [ [Input](#id-1.17APIนำข้อมูลเข้าDepositpay(รับชำระผ่านทุกช่องทางของโครงการe-Receipt)-Input) ] [ [Process Description](#id-1.17APIนำข้อมูลเข้าDepositpay(รับชำระผ่านทุกช่องทางของโครงการe-Receipt)-ProcessDescription) ] [ [Post-Condition](#id-1.17APIนำข้อมูลเข้าDepositpay(รับชำระผ่านทุกช่องทางของโครงการe-Receipt)-Post-Condition) ]\\n\\n## Objective\\n\\n- API ของระบบ Depositpay\\n- เพื่อรับข้อมูลการชำระเบี้ยผ่านทุกช่องทาง สำหรับบันทึกยังระบบ MSA-Depositpay (ข้อมูลรายการรับชำระ)\\n- ตรวจสอบข้อมูลก่อนบันทึกข้อมูลลง MSA-Depositpay\\n- บันทึกข้อมูลลง MSA-Depositpay\\n- บันทึกข้อมูลลง เว็บรับฝาก (เป็นการตั้งรับฝากสาขา)\\n  - ยกเว้น รายการตัวแทนนำส่งเงิน จะไม่ทำการตั้งรับฝาก\\n- ส่งผลกลับไปให้ผู้เรียก MSA\\n\\n## Overview\\n\\n1. จัดเตรียมข้อมูลรายละเอียดข้อมูลการชำระเบี้ย\\n  1. จัดการข้อมูลที่รับมาจากทุกช่องทาง\\n  2. ค้นหาข้อมูลกรมธรรม์ ที่ระบบ AS400 แยกหาตามประเภทกรมธรรม์\\n2. นำข้อมูลที่ได้บันทึกลง ที่ MSA-Depositpay( Table [TX_HYDRA_IMPORT_HEADER](http://wiki.thaisamut.co.th/display/RDSTQP/TX_HYDRA_IMPORT_HEADER) และ [TX_HYDRA_IMPORT_DETAIL](http://wiki.thaisamut.co.th/display/RDSTQP/TX_HYDRA_IMPORT_DETAIL) )\\n3. นำข้อมูลบันทึกที่ ตั้งรับฝาก ทุกรายการที่ชำระด้วย ทุกช่องทาง\\n  1. กรณีที่บันทึกเว็บรับฝากไม่สำเร็จให้ update รายการที่ Table TX_HYDRA_IMPORT_HEADER และ TX_HYDRA_IMPORT_DETAIL\\n  2. กรณีที่บันทึกเว็บรับฝากสำเร็จ update ข้อมูล เลขที่รับฝาก และ วันที่รับฝาก Table TX_HYDRA_IMPORT_HEADER และ TX_HYDRA_IMPORT_DETAIL\\n4. Return สถานะการนำเข้าข้อมูลไปยังระบบต้นทาง\\n\\n## Flow การทำงาน\\n\\n- [https://app.diagrams.net/#G1tUQ9FPm-2CXIjnQ5QGMoo0_fg8Qghwxa#%7B%22pageId%22%3A%22kda8uztsC-FnA46-D5Si%22%7D](https://app.diagrams.net/#G1tUQ9FPm-2CXIjnQ5QGMoo0_fg8Qghwxa#%7B%22pageId%22%3A%22kda8uztsC-FnA46-D5Si%22%7D)\\n\\n## Ref FS\\n\\n- [MSA-Depositpay ดึงข้อมูลจาก Thai QR เข้า MSA-Depositpay](/pages/viewpage.action?pageId=799179158)\\n\\n## Pre-Condition\\n\\n1. ชำระเบี้ยสำเร็จจากช่องทางดังนี้\\n  1. BBL Payment Gateway อ้างอิง : [02_09 กระบวนการส่งข้อมูลเพื่อสร้างใบเสร็จ ที่ระบบใบเสร็จส่วนกลาง (e-Receipt)](/pages/viewpage.action?pageId=1280737623)\\n  2. LC Connect CASH อ้างอิง : [02_09 กระบวนการส่งข้อมูลเพื่อสร้างใบเสร็จ ที่ระบบใบเสร็จส่วนกลาง (e-Receipt)](/pages/viewpage.action?pageId=1280737623)\\n  3. Thai QR : [Process การส่งข้อมูลการชำระเบี้ยจากระบบ Thai QR Payment ไปยังระบบ Deposit Pay และ Hydra (Call Service MSA-Depositpay ทันที)](/pages/viewpage.action?pageId=1257341391)\\n  4. CLAWBACK (paymentTypeCode = 16) : [Process การส่งข้อมูลการชำระเบี้ยจากระบบ Thai QR Payment ไปยังระบบ Deposit Pay และ Hydra (Call Service MSA-Depositpay ทันที)](/pages/viewpage.action?pageId=1257341391)\\n  5. ชำระเบี้ยผ่านการกู้เงิน (โครงการ New Loan 18/03/2569)\\n\\n## Input\\n\\nParameter ดังนี้\\n\\n| Name | Type | Description | Example | Required/Optional | Validation |\\n|---|---|---|---|---|---|\\n| **Header** |\\n| policyNo | String | เลขที่กรมธรรม์ / เลขที่อ้างอิงกรณีตัวแทนนำส่ง | 1696873 | Optional | กรณีปีต่อ / ปีแรก งวดต่อ ช่องทางชำระ CB, CREDITCARD, CASH ให้ส่งเลขที่กรมธรรม์กรณีปีต่อ / ปีแรก งวดต่อ ช่องทางชำระ CB (ตัวแทนนำส่ง) ให้ส่งเลขที่อ้างอิง |\\n| policyType | String | ประเภทกรมธรรม์ | ORDINDPA | Optional | paymentTypeCode = 16 จะส่งค่า policy type มา |\\n| mainChannelCode | String | รหัสช่องทางหลัก | CREDITCARD | Required | ชำระผ่าน Payment Gateway ให้ส่งค่า CREDITCARDชำระผ่าน LC Connect CASH ให้ส่งค่า CASHชำระผ่าน Thai QR ให้ส่งค่า CBโครงการ New Loan 18/03/2569กรณีชำระคืนเงินกู้ผ่าน Thai QR ให้ส่งค่า CB |\\n| paymentDate | DateTime | วันที่เวลาชำระเบี้ย | 08/07/2020 08:30:45 | Required | รูปแบบ DD/MM/YYYY hh:mm:ss (ปีค.ศ.) |\\n| paymentMethod | String | วิธีการชำระ |   | Optional | ชำระผ่าน Thai QR ให้ส่งค่า TQP |\\n| channelCode | String | รหัสช่องทางการชำระ | 002 | Required | ชำระผ่าน Payment Gateway ให้ส่งค่า 002ชำระผ่าน LC Connect CASH ให้ส่งค่า CASH C01ชำระผ่าน Thai QR ให้ส่งค่า 002 |\\n| paymentTypeCode | String | ประเภทการชำระเงิน | 52 | Optional | ชำระเบี้ยสามัญ ให้ส่งค่า 51ชำระเบี้ยอุสาหกรรม ให้ส่งค่า 52ชำระเบี้ยประกัน PA ให้ส่งค่า 53ชำระเบี้ยประกัน PAR ให้ส่งค่า 63ชำระเบี้ยรายการตัวแทนนำส่งเงิน ให้ส่งค่า 84APL (ชำระคืนเงินกู้ พร้อมดอกเบี้ย , ชำระดอกเบี้ย) ให้ส่งค่า 19PL (ชำระคืนเงินกู้ พร้อมดอกเบี้ย , ชำระดอกเบี้ย) ให้ส่งค่า 20APL/PL (ชำระคืนเงินกู้ พร้อมดอกเบี้ย , ชำระดอกเบี้ย บางส่วน) ให้ส่งค่า 21APL/PL (ชำระคืนเงินกู้ พร้อมดอกเบี้ย , ชำระดอกเบี้ย ทั้งหมด) ให้ส่งค่า 22 |\\n| bankCode | String | รหัสธนาคาร | 002 | RequiredOptional | ชำระผ่าน Payment Gateway (LC Connect) ให้ส่งค่า 002ชำระผ่าน LC Connect CASH ให้ส่งค่า CASH C01ชำระผ่าน Thai QR ให้ส่งค่า 002 |\\n| ref1 | String | Ref1 |   | Optional | ชำระผ่าน Payment Gateway ให้ส่งค่า xxxชำระผ่าน LC Connect CASH ให้ส่งค่าว่างชำระผ่าน Thai QR ให้ส่งค่า reference1 |\\n| ref2 | String | Ref2 |   | Optional | ชำระผ่าน Thai QR ให้ส่งค่า reference2 |\\n| ref3 | String | Ref3 |   | Optional | paymentTypeCode = 16 จะส่งค่าเป็น reference_no (11 หลัก) โครงการ New Loan 18/03/2569paymentTypeCode in (19,20,21,22) reference_no (11 หลัก) กรณีรับข้อมูลจาก Thai QR จะมี ref3 เสมอ |\\n| customerName | String | ชื่อผู้ชำระเงิน | คุณทำใจ นานนาน | Required |   |\\n| paymentAmount | Currency | จำนวนเงินที่ชำระ | 5,000.00 | Required |   |\\n| feeAmount | Currency | ค่าธรรมเนียมธนาคารรอเรียกเก็บ (กรณีเรียกเก็บตัวแทน) | 0.00 | Optional | กรณีชำระผ่าน Payment Gateway |\\n| creditcardFeeAmount | Currency | ค่าธรรมเนียมบัตรเครดิต | 100.00 | Optional | กรณีชำระผ่าน Payment Gateway |\\n| refPaymentNo | Number | Ref. Record ID ของรายการชำระเบี้ย tqp_tx_payment_completed_id |   | Required |   |\\n| refferenceNoOther | String | เลข refference เพิ่มเติมของรายการชำระ | DEBTM256811100001 | Optional | paymentTypeCode = 16 จะส่งค่าเป็น debt_code (เลขที่รายการหนี้สิน) |\\n| orglFileName | String | ชื่อชุดข้อมูล |   | Required | ตัวอย่างข้อมูล CREDITCARDLCC08072020083045ใช้ข้อมูลจาก รหัสช่องทางหลัก& ชื่อ Application ของรายการ&Current datetimeโดยที่ Current datetim กำหนด Format: DDMMYYYYHHMMSS (ปี ค.ศ.) |\\n| appName | String | ชื่อ Application ของรายการ | LCC | Optional | กรณีรายการ LCC ที่ชำระผ่าน Thai QR : ระบบ Thai QR จะส่งค่า LCCโครงการ New Loan 18/03/2569กรณีชำระคืนเงินกู้ผ่าน Thai QR ให้ส่งค่า LOAN |\\n| agentCode |   | รหัสตัวแทน 7หลัก add by nattapong.che on 24/06/69 |   | Optional |   |\\n|   |   |   |   |   |   |\\n\\nหมายเหตุ : ข้อมูลในส่วน Agent Data และ Agent Receipt (List) ยกเลิกเนื่องจากระบบ LC ตัวแทนไม่สามารถรับชำระเงินจากลูกค้าเป็นเงินสด จึงยกเลิกรายการตัวแทนนำส่งเงิน --chareeporn.pa 25/01/2026\\n\\n## Process Description\\n\\nให้นำชุดข้อมูลที่รับมาจากต้นทาง มาวน loop หาข้อมูลและบันทึกข้อมูลตามขั้นตอนการจัดการข้อมูลดังนี้\\n**Remark :**\\n- **concept** การบันทึกข้อมูลลง **Table**[TX_HYDRA_IMPORT_HEADER](/display/RDSTQP/TX_HYDRA_IMPORT_HEADER) กับ [TX_HYDRA_IMPORT_DETAIL](/display/RDSTQP/TX_HYDRA_IMPORT_DETAIL) **เป็น 1 Header ต่อ 1 Detail**\\n\\n### **ขั้นตอนการจัดการข้อมูลดังนี้**\\n\\n/*<![CDATA[*/ div.rbtoc1784798161168 {padding: 0px;} div.rbtoc1784798161168 ul {list-style: disc;margin-left: 0px;} div.rbtoc1784798161168 li {margin-left: 0px;padding-left: 0px;} /*]]>*/\\n- [1.จัดเตรียมข้อมูลของรายการชำระเบี้ยจากทุกช่องทาง](#id-1.17APIนำข้อมูลเข้าDepositpay(รับชำระผ่านทุกช่องทางของโครงการe-Receipt)-1.จัดเตรียมข้อมูลของรายการชำระเบี้ยจากทุกช่องทาง)\\n- [2. บันทึกข้อมูล (DB : Deposit)](#id-1.17APIนำข้อมูลเข้าDepositpay(รับชำระผ่านทุกช่องทางของโครงการe-Receipt)-2.บันทึกข้อมูล(DB:Deposit))\\n- [3. ให้นำข้อมูลจาก Table Hydra (DB : Deposit) เพื่อนำไปตั้งรับฝาก](#id-1.17APIนำข้อมูลเข้าDepositpay(รับชำระผ่านทุกช่องทางของโครงการe-Receipt)-3.ให้นำข้อมูลจากTableHydra(DB:Deposit)เพื่อนำไปตั้งรับฝาก)\\n- [4. Call MSA ระบบ Hydra เพื่อส่งข้อมูลให้ระบบ Hydra](#id-1.17APIนำข้อมูลเข้าDepositpay(รับชำระผ่านทุกช่องทางของโครงการe-Receipt)-4.CallMSAระบบHydraเพื่อส่งข้อมูลให้ระบบHydra)\\n- [5. Return สถานะการนำเข้าข้อมูลขสองแต่ละรายการ กลับไปให้ระบบต้นทาง โดยสถานะที่ส่งกลับมี ดังนี้](#id-1.17APIนำข้อมูลเข้าDepositpay(รับชำระผ่านทุกช่องทางของโครงการe-Receipt)-5.Returnสถานะการนำเข้าข้อมูลขสองแต่ละรายการกลับไปให้ระบบต้นทางโดยสถานะที่ส่งกลับมีดังนี้)\\n- [6. รายการที่บันทึกที่ Hydra สำเร็จ (ข้อ 4) Call API ดึงข้อมูลรายการชำระเพื่อเตรียมส่งเข้า Hermes](#id-1.17APIนำข้อมูลเข้าDepositpay(รับชำระผ่านทุกช่องทางของโครงการe-Receipt)-6.รายการที่บันทึกที่Hydraสำเร็จ(ข้อ4)CallAPIดึงข้อมูลรายการชำระเพื่อเตรียมส่งเข้าHermes)\\n- [7. Call ESB ของ Hermes เพื่อ Import ข้อมูลเข้า Hermes](#id-1.17APIนำข้อมูลเข้าDepositpay(รับชำระผ่านทุกช่องทางของโครงการe-Receipt)-7.CallESBของHermesเพื่อImportข้อมูลเข้าHermes)\\n****\\n\\n### 1.จัดเตรียมข้อมูลของรายการชำระเบี้ยจากทุกช่องทาง\\n\\n**ขั้นตอนมีดังนี้**\\nอ้างอิง : [จัดเตรียมข้อมูลรายละเอียดข้อมูลการชำระเบี้ย](/pages/viewpage.action?pageId=776208730)\\nStep 1 : หาประเภทเอกสารที่รับชำระ และ REF1_10 ของรายการ Thai QR\\n1. **หาประเภทเอกสารที่รับชำระ**\\n  1. นำข้อมูล \\\"ประเภทการชำระเงิน\\\" ที่รับค่าจาก input param ไปหาข้อมูลดังนี้\\n    1. หาค่า [HYDRA - PAYMENT_TYPE](/display/RDSOTHCHPAY/HYDRA+-+PAYMENT_TYPE).DOC_TYPE ที่ [HYDRA - PAYMENT_TYPE](/display/RDSOTHCHPAY/HYDRA+-+PAYMENT_TYPE).PAYMENT_TYPE_CODE = paymentTypeCode\\n    2. กรณี payment_type.doc_type = 2 ให้ กำหนดประเภทเอกสารที่รับชำระ เป็น 4 อ้างอิง [![img](http://jira.thaisamut.co.th/images/icons/issuetypes/subtask_alternate.png)ADW-13150](http://jira.thaisamut.co.th/browse/ADW-13150) - [ใบเสร็จส่วนกลาง] แก้ไขหน้าตรวจสอบข้อมูลนำเข้า (![img](http://jira.thaisamut.co.th/images/icons/statuses/resolved.png) Resolved) 23/04/2568 by Raiwin.ph :\\n2. **หาจำนวน 10 หลักของ**REF1**(REF1_10):** โดยตัดเอา REF1 ตำแหน่งที่ 4 ถึง 13\\n  1. ยกเว้นรายการที่\\n    1. mainChannelCode = CASH และ CREDITCARD\\nStep 2 : ตรวจสอบเลขที่กรมธรรม์ หรือ ข้อมูลสนงตัวแทน และอื่นๆ จากระบบ AS/400\\n**2.1 กรณีที่****ที่รับมาจากต้นทาง มีข้อมูล :** ให้นำ เลขที่กรมธรรม์ ไปตรวจสอบข้อมูลจากระบบ AS/400 ตามรายละเอียดดังนี้\\n\\n| ตรวจสอบ \\\"ประเภทการชำระเงิน\\\" | ประเภทกรมธรรม์ | Web Service ที่เรียกใช้ / แหล่งข้อมูล | การกำหนดค่าเพื่อเตรียมนำไปบันทึกลง [TX_HYDRA_IMPORT_HEADER](/display/RDSTQP/TX_HYDRA_IMPORT_HEADER)**และ [TX_HYDRA_IMPORT_DETAIL](/display/RDSTQP/TX_HYDRA_IMPORT_DETAIL)** |\\n|---|---|---|---|\\n| paymentTypeCode in ('51','58',) | สามัญ | เรียกใช้ Web Service [msa-policy ค้นหาข้อมูลกรมธรรม์จาก as400ที่ระบบ msa-policy](/pages/viewpage.action?pageId=798916693) | เมื่อได้ข้อมูลจาก Web Service แล้วให้กำหนดค่าดังต่อไปนี้ Click here to expand... ข้อมูลวิธีการหาเลขกรมธรรม์ กำหนดให้เป็น เลขกรมธรรม์ที่รับมาจากต้นทางเลขที่กรมธรรม์ในระบบ AS/400 กำหนดให้เป็น policy_no จาก Web Service ประเภทกรมธรรม์ประเภทกรมธรรม์ จาก Web Service ให้ Mapping ดังนี้ รายละเอียดการMapping รหัสประเภทกรมธรรม์ รหัสประเภทกรมธรรม์ (policyType)คำอธิบายให้ Mappingค่าลง Hydra ดังนี้Iอุตสาหกรรม ปช.INDGอุตสาหกรรม ขพ.GOVOสามัญORD แบบประกันplan จาก Web Service คำนำหน้าชื่อกำหนดให้เป็น title_name จาก Web Service ชื่อผู้เอาประกัน หรือ ชื่อสำนักงานตัวแทนกำหนดให้เป็น fname จาก Web Service นามสกุลกำหนดให้เป็น lname จาก Web Service****รหัสสาขา(BRANCH_CODE)ใช้ค่า branch_code7 รหัสสาขา 7 หลัก จาก Web ServiceREF1_10 กำหนดให้เป็น **REF1_10** (ตำแน่งที่ 4-13 1ของ REF1)รหัสตัวแทน 7 หลักกำหนดให้เป็น agent_code7 จาก Web Service รหัสตัวแทน 5 หลักกำหนดให้เป็น Null เบี้ยรายเดือน (PREMIUM_MONTH_AMOUNT) กำหนดให้เป็น premium_month_amount จาก Web Service Mode (PAYMENT MODE) กำหนดให้เป็น payment_mode จาก Web Service |\\n| ข้อมูล | วิธีการหา |\\n| เลขกรมธรรม์ | กำหนดให้เป็น เลขกรมธรรม์ที่รับมาจา