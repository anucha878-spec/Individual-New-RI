PENH/tx_batch_payment\"},{\"text\":\"tx_payment_detail\",\"href\":\"http://wiki.thaisamut.co.th/display/RDSCPENH/tx_payment_detail\"},{\"text\":\"tx_payment_detail\",\"href\":\"http://wiki.thaisamut.co.th/display/RDSCPENH/tx_payment_detail\"},{\"text\":\"Bank Format Code\",\"href\":\"http://wiki.thaisamut.co.th/display/RDSCPENH/1.Bank+Format+Code\"},{\"text\":\"tx_payment_detail\",\"href\":\"http://wiki.thaisamut.co.th/display/RDSCPENH/tx_payment_detail\"},{\"text\":\"Bank Format Code\",\"href\":\"http://wiki.thaisamut.co.th/display/RDSCPENH/1.Bank+Format+Code\"},{\"text\":\"tx_payment_detail\",\"href\":\"http://wiki.thaisamut.co.th/display/RDSCPENH/tx_payment_detail\"},{\"text\":\"57429\",\"href\":\"https://redmine.ochi.link/issues/57429\"},{\"text\":\"tx_batch_payment\",\"href\":\"http://wiki.thaisamut.co.th/display/RDSCPENH/tx_batch_payment\"},{\"text\":\"tx_payment_detail\",\"href\":\"http://wiki.thaisamut.co.th/display/RDSCPENH/tx_payment_detail\"}],\"atts\":[]},{\"id\":\"1296793682\",\"title\":\"Batch Payment\",\"url\":\"/display/RDSCPENH/Batch+Payment\",\"parent\":\"1271234881\",\"depth\":4,\"status\":200,\"md\":\"**Knowledge Sharing**\\n- **วิธีการบันทึกผลการขึ้นเงิน/โอนเงิน**แบ่งเป็น 2 วิธีดังนี้\\n    - บันทึกผลแบบ Auto : ระบบจะรองรับรูปแบบไฟล์ .txt และ .csv ในการการอัปโหลดไฟล์เพื่อประมวลผลการขึ้นเงินเท่านั้น\\n    - บันทึกผลแบบ Manual : ระบบจะรองรับไฟล์ทุกรูปแบบ โดยระบบจะไม่มีการประมวลผลจากไฟล์ที่อัปโหลด เจ้าหน้าที่การเงินที่ทำรายการต้องเป็นผู้บันทึกผลด้วยตัวเองเท่านั้น\\n    - ภายใต้ Voucher เดียวกัน ระบบจะรองรับการบันทึกผลวิธีใดวิธีหนึ่งเท่านั้นจะไม่สามารถผสมผสานกันทั้ง 2 วิธี (ต่างกับ Paperbase - เช็ค โดยที่ 1 Voucher จะรองรับทั้ง 2 วิธี) เมื่อทุกรายการภายใต้ Voucher ดำเนินการเปลี่ยนสถานะเช็คครบถ้วนแล้ว จึงจะเปลี่ยนสถานะในตาราง [tx_payment_dashboard](/display/RDSCPENH/tx_payment_dashboard) เปลี่ยนสถานะ Voucher เป็น \\\"จ่ายสำเร็จ\\\" หรือ \\\"จ่ายสำเร็จบางส่วน\\\" หรือ \\\"จ่ายไม่สำเร็จ\\\" อ้างอิงตามเงื่อนไขของหน้าจอบันทึกผลการโอนเงิน\",\"links\":[{\"text\":\"tx_payment_dashboard\",\"href\":\"/display/RDSCPENH/tx_payment_dashboard\"}],\"atts\":[]},{\"id\":\"1296793685\",\"title\":\"Paperbase\",\"url\":\"/display/RDSCPENH/Paperbase\",\"parent\":\"1271234881\",\"depth\":4,\"status\":200,\"md\":\"**Knowledge Sharing**\\n- **เช็คหมดอายุ** แบ่งเงื่อนไขการคำนวณวันที่หมดอายุของเช็คเป็น 2 ประเภทดังนี้\\n    - เช็คบริษัท / เช็ค UOB : เช็คมีอายุ 180 วัน ประมวลผลเช็คหมดอายุ ณ วันที่ 181 เวลา 22.30 น. >> ดำเนินการโดย Batch Daily : [PM_BH_003 อัปเดตสถานะเช็คหมดอายุ](/pages/viewpage.action?pageId=1293124517)\\n    - Bank Cheque_SCBT : เช็คมีอายุ 380 วัน ประมวลผลเช็คหมดอายุ วันที่ 381 เวลา 22.30 น. *>> ยังไม่มีกระบวนการรองรับ*\\n    - เงื่อนไขในการนับ SLA วันที่หมดอายุ : ระบบจะนับวันที่พิมพ์เช็คเป็นวันที่ 1 (T) และบวก 180 วัน (T+180 นับรวมวันหยุด) เป็นวันที่ Batch Daily ดำเนินการอัปเดตสถานะรายการในตาราง [tx_paperbase_status](/display/RDSCPENH/tx_paperbase_status) เปลี่ยนสถานะเช็คเป็น \\\"เช็คหมดอายุ\\\" **\\n- **รายการในไฟล์ผลการขึ้นเงินเช็ค (ฺCheque - Bank Statement)**\\n    - รายการที่แสดงในไฟล์ตอบกลับจากธนาคารต่างๆ จะแสดงเฉพาะรายการที่ลูกค้านำเช็คไปขึ้นเงินสำเร็จเท่านั้น ดังนั้นเมื่อบันทึกผลการขึ้นเงินเช็ค อ้างอิงจากไฟล์ธนาคาร หากพบรายการ ระบบจะเปลี่ยนสถานะในตาราง [tx_paperbase_status](/display/RDSCPENH/tx_paperbase_status) เปลี่ยนสถานะเช็คเป็น \\\"เช็คขึ้นเงินแล้ว\\\"\\n    - กรณีเช็คชำรุดเสียหาย/เช็คมีปัญหา หรือเหตุผลอื่นๆ ธนาคารจะไม่สามารถขึ้นเช็คได้ ดังนั้นจะไม่แสดงรายการเช็คในไฟล์ธนาคาร (ทุกธนาคารมีเกณฑ์ขึ้นเงินเหมือนกันคือ เช็คปกติสามารถขึ้นเงินได้ก่อนเวลา 14.00 น. ของทุกวันทำการ)\\n- **วิธีการบันทึกผลการขึ้นเงินเช็ค** แบ่งเป็น 2 วิธีดังนี้\\n    - บันทึกผลแบบ Auto : ระบบจะรองรับรูปแบบไฟล์ .txt และ .csv ในการการอัปโหลดไฟล์เพื่อประมวลผลการขึ้นเงินเท่านั้น\\n    - บันทึกผลแบบ Manual : ระบบจะรองรับไฟล์ทุกรูปแบบ โดยระบบจะไม่มีการประมวลผลจากไฟล์ที่อัปโหลด เจ้าหน้าที่การเงินที่ทำรายการต้องเป็นผู้บันทึกผลด้วยตัวเองเท่านั้น\\n    - ภายใต้ Voucher เดียวกัน ระบบจะรองรับการบันทึกผลทั้ง Auto และ Manual ผสมผสานกันได้ทั้ง 2 วิธี (ต่างกับ Batch Payment โดยที่ 1 Voucher จะรองรับเพียง 1 วิธีเท่านั้น) เมื่อทุกรายการภายใต้ Voucher ดำเนินการเปลี่ยนสถานะเช็คครบถ้วนแล้ว จึงจะเปลี่ยนสถานะในตาราง [tx_payment_dashboard](/display/RDSCPENH/tx_payment_dashboard) เปลี่ยนสถานะ Voucher เป็น \\\"จ่ายสำเร็จ\\\" หรือ \\\"จ่ายสำเร็จบางส่วน\\\" หรือ \\\"จ่ายไม่สำเร็จ\\\" อ้างอิงตามเงื่อนไขของหน้าจอบันทึกผลการจ่ายเช็ค\\nกรณีไฟล์ต้นฉบับเป็น Excel ฝ่ายการเงินจะแปลงเป็น CSV และนำมา Import ในระบบ\\n* มีเฉพาะ Kbank ที่ได้ csv จากธนาคาร Encode เป็น TIS-620 เท่านั้น ธนาคารอื่นๆจะได้ไฟล์เป็น Excel และต้องแปลงเป็น csv encode UTF-8 เพื่อนำเข้าระบบ\\n\\n| Service | Encode | Example File (SIT) | Example File (UAT) | Issue |\\n|---|---|---|---|---|\\n| [Paperbase Cheque - BBL (.xls)](http://wiki.thaisamut.co.th/pages/viewpage.action?pageId=1296793718) | UTF-8 | [BBL_1473129649 01.07.2025](https://docs.google.com/spreadsheets/d/1pcvDvKWApGTMlYLNi1P8VlTdsK03cjWm/edit?usp=drive_link&ouid=111414406903825301529&rtpof=true&sd=true) | [BBL_1473108767 01-28.02.2026](https://docs.google.com/spreadsheets/d/1z--3erHdf1gA_rndGf1eotm0BRFvg9Ho/edit?usp=sharing&ouid=111414406903825301529&rtpof=true&sd=true) |   |\\n| [Paperbase Cheque - KTB (.xls)](http://wiki.thaisamut.co.th/pages/viewpage.action?pageId=1296793716) | UTF-8 | [KTB_0236064770 01-23.07.2025](https://docs.google.com/spreadsheets/d/1cj9ZbaahMugJWxBptpZw_fuX-8tKuaeU/edit?usp=sharing&ouid=111414406903825301529&rtpof=true&sd=true) | [KTB_0236064770 01-28.02.2026](https://docs.google.com/spreadsheets/d/1U6o9m9_3wVAvMJe1D8oShgHkWL67Guqw/edit?usp=sharing&ouid=111414406903825301529&rtpof=true&sd=true) | ปรับการอ่านไฟล์เริ่มบรรทัดแรกจาก Account No. เนื่องจากไม่สามารถกำหนดจำนวน Row ของ Logo ได้[https://redmine.ochi.link/issues/62514](https://redmine.ochi.link/issues/62514) |\\n| [Paperbase Cheque - BAY (.csv*)](http://wiki.thaisamut.co.th/pages/viewpage.action?pageId=1296793720) | UTF-8 | [BAY_1090023938 01.07.2025](https://docs.google.com/spreadsheets/d/1lICKwYBRHrgwLLUnV9g9s_9s9c6oGyWJ-